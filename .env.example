# Copy this file to `.env` locally, then add the same keys in Vercel:
# Project → Settings → Environment Variables → Import .env

# Clerk (required for login)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# App URL (your Vercel domain, e.g. https://magicai.vercel.app)
NEXT_PUBLIC_APP_URL=

# Image generation — ClipDrop (required for /image)
CLIPDROP_API_KEY=

# Image — Hugging Face (required for /Stablediffusion)
NEXT_PUBLIC_HUGGINGFACE_API_KEY=

# Background removal (required for /bgremove)
NEXT_PUBLIC_REMOVE_BG_API_KEY=

# Gemini (required for /conversation, /code, /smart)
NEXT_PUBLIC_GEMINI_AI_API_KEY=

# Text to speech (required for /t2s)
NEXT_PUBLIC_ELEVENLABS_API_KEY=

# Video / image-to-video (required for /video, /i2v)
NEXT_PUBLIC_RAPIDAPI_KEY=

# Optional / legacy (not all routes use these)
OPENAI_API_KEY=
NEXT_PUBLIC_OPENAI_API_KEY=
NEXT_PUBLIC_API_URL=
API_KEY=
REPLICATE_API_TOKEN=
NEXT_PUBLIC_REPLICATE_API_TOKEN=
NEXT_PUBLIC_ASSEMBLYAI_API_KEY=
MONGODB_URI=
STRIPE_API_KEY=
